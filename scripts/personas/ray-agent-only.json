{
  "id": "ray-agent-only",
  "name": "Ray",
  "profile": "50yo agent-only user, no website, Telegram + Garmin, premium",
  "tier": "premium",
  "mode": "api",
  "steps": [
    {
      "name": "Ask AI to create workout",
      "type": "api",
      "port": 8005,
      "endpoint": "/chat/stream",
      "method": "POST",
      "body": {"message": "Create a 45-minute upper body workout for today. Use the generate_workout tool."},
      "expectStream": true,
      "expectToolOrContent": "generate_workout"
    },
    {
      "name": "Map exercises to Garmin",
      "type": "api",
      "port": 8001,
      "endpoint": "/exercises/match/batch",
      "method": "POST",
      "body": {"names": ["Bench Press", "Overhead Press", "Dumbbell Row", "Lateral Raise", "Tricep Pushdown"]},
      "expectField": "results"
    },
    {
      "name": "Push workout to Garmin",
      "type": "api",
      "port": 8099,
      "_note": "Uses MOCK Garmin (8099), never real (8002). Endpoint path matches mock_garmin_server.py: POST /workout-service/workout (singular).",
      "endpoint": "/workout-service/workout",
      "method": "POST",
      "body": {"workoutName": "Upper Body Day", "sportType": {"sportTypeKey": "strength_training"}, "workoutSegments": [{"segmentOrder": 1, "sportType": {"sportTypeKey": "strength_training"}, "workoutSteps": [{"type": "ExecutableStepDTO", "stepOrder": 1, "description": "Bench Press", "durationType": {"durationTypeKey": "reps"}, "durationValue": 10}, {"type": "ExecutableStepDTO", "stepOrder": 2, "description": "Overhead Press", "durationType": {"durationTypeKey": "reps"}, "durationValue": 12}, {"type": "ExecutableStepDTO", "stepOrder": 3, "description": "Dumbbell Row", "durationType": {"durationTypeKey": "reps"}, "durationValue": 10}]}]}
    },
    {
      "name": "Verify workout on mock Garmin",
      "type": "api",
      "port": 8099,
      "_note": "Mock returns {workouts: [...]} not a bare array. Use nested length check.",
      "endpoint": "/workout-service/workouts",
      "method": "GET",
      "expectField": "workouts.length > 0"
    },
    {
      "name": "Ask AI what I did last week",
      "type": "api",
      "port": 8005,
      "endpoint": "/chat/stream",
      "method": "POST",
      "body": {"message": "What workouts did I do last week?"},
      "expectStream": true
    },
    {
      "name": "Check exercise matching accuracy",
      "type": "api",
      "port": 8001,
      "endpoint": "/exercises/match",
      "method": "POST",
      "body": {"name": "bench press"},
      "expectField": "matched_name"
    },
    {
      "name": "Check health endpoints",
      "type": "api-multi",
      "checks": [
        {"port": 8001, "endpoint": "/health"},
        {"port": 8003, "endpoint": "/health"},
        {"port": 8004, "endpoint": "/health"},
        {"port": 8005, "endpoint": "/health"}
      ]
    }
  ]
}
